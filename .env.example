# Copy this file to ".env" and fill in your key. ".env" is gitignored.

# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Port the local server listens on (optional; defaults to 3016)
PORT=3016

# Cheap text model used by the "Enhance prompt" toggle (optional; defaults to google/gemini-2.5-flash)
ENHANCE_MODEL=google/gemini-2.5-flash
